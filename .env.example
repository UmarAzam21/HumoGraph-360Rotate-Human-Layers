# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# whisper-large-v3 = most accurate, whisper-large-v3-turbo = faster
STT_MODEL=whisper-large-v3

# Optional default language (ISO-639-1, e.g. en, ur). Leave empty for auto-detect.
STT_DEFAULT_LANGUAGE=

MAX_UPLOAD_MB=25
DEBUG=false

# Only needed if the frontend is served from a different origin, e.g. ["http://localhost:5173"]
# CORS_ORIGINS=[]
